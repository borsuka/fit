# ============================================================================
# Copy to .env and fill in. NEVER commit .env.
# ============================================================================

# ----------------------------------------------------------------------------
# CLIENT — bundled into the app and readable by anyone who downloads it.
# EXPO_PUBLIC_* is public BY DEFINITION. Only put values here that are safe to
# publish. The Supabase anon key is safe: it grants nothing on its own because
# Row Level Security decides what each JWT may read.
# ----------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Leave empty to disable error reporting in local development.
EXPO_PUBLIC_SENTRY_DSN=

# 'development' | 'preview' | 'production'
EXPO_PUBLIC_APP_ENV=development

# ----------------------------------------------------------------------------
# SERVER — Supabase Edge Function secrets. Set with:
#   npx supabase secrets set KEY=value
#
# These MUST NOT appear in the client bundle or carry an EXPO_PUBLIC_ prefix.
# An AI vendor key shipped in an app bundle is a public key, and the bill
# arrives before anyone notices.
# ----------------------------------------------------------------------------

# service_role bypasses RLS entirely. Edge functions only. Never the client.
SUPABASE_SERVICE_ROLE_KEY=

# Vision provider selection — see decision D-1 (bake-off) in ARCHITECTURE.md.
# 'anthropic' | 'openai' | 'google'
AI_VISION_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=

# Nutrition data sources (decision D-2: hybrid seed plus write-through cache).
USDA_FDC_API_KEY=
OPEN_FOOD_FACTS_USER_AGENT=fit-app/0.1 (contact@example.com)

# Subscription webhook signature verification.
REVENUECAT_WEBHOOK_SECRET=
